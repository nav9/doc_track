# --- General AI Agent Workspace & Scratchpad Artifacts ---
# Generic hidden agent directories, logs, and prompt histories
.agents/
.agent/
.copilot/
.cursor/
.continue/
.aide/
.cline/
.roo-cline/
.pearai/
.genius/
.codeium/
.supermaven/
.tabnine/
.mely/
*agent.log
*.agent.log
agent_workspace/
ai_scratchpad/
llm_prompts.md
.ai_context/

# --- Windsurf (Codeium) ---
# Windsurf specific state, session caches, and configuration directories
.windsurf/
.codeium/
windsurf-server/
.windsurf-cache/

# --- Google Antigravity ---
# Workspace scoped agent skills and project runtime configs
.agents/skills/
.gemini/config/

# --- Codex, Kilo, Freebuff & Other Specialized Agents ---
# Local cache, model checkpoints, runtime traces, and generation logs
.codex/
.kilo/
.freebuff/
.freebuff-cache/
freebuff_output/
kilo_scratch/
.kilo-internal/

# --- Temporary Code Generations & Shell Executions ---
# Auto-generated script drafts, test runners, and command execution stubs
.agent_tmp/
.ai_generated/
ai_patch_*.patch
*.preview.js
*.preview.ts
*.preview.py
.execution_sandbox/

