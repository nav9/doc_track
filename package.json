{
  "name": "doctrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DocTrack — offline-first leave planning and duty roster PWA for doctors",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "check": "node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.69.0",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "zod": "^4.6.7"
  }
}
